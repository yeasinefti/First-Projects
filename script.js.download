function createEl(tag, className, text) {
  const el = document.createElement(tag);
  if (className) el.className = className;
  if (typeof text === 'string') el.textContent = text;
  return el;
}

function prefersReducedMotion() {
  return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
}

function isFinePointer() {
  return window.matchMedia('(pointer: fine)').matches;
}

function attachCardSheen(el) {
  if (!(el instanceof HTMLElement) || prefersReducedMotion() || !isFinePointer()) return;
  el.classList.add('has-sheen');
  el.addEventListener(
    'mousemove',
    (e) => {
      const rect = el.getBoundingClientRect();
      const mx = e.clientX - rect.left;
      const my = e.clientY - rect.top;
      el.style.setProperty('--mx', `${mx.toFixed(1)}px`);
      el.style.setProperty('--my', `${my.toFixed(1)}px`);
    },
    { passive: true }
  );
}

function splitHeroTitle() {
  const heroTitle = document.querySelector('.hero-title');
  if (!heroTitle || prefersReducedMotion()) return;
  const rawText = (heroTitle.textContent || '').replace(/\s+/g, ' ').trim();
  if (!rawText) return;

  heroTitle.setAttribute('aria-label', rawText);
  heroTitle.replaceChildren();
  const words = rawText.split(' ');

  words.forEach((word, wIdx) => {
    const wordSpan = createEl('span', 'split-word');
    wordSpan.setAttribute('aria-hidden', 'true');
    const isBrandName = word.toUpperCase().startsWith('YEASIN');

    Array.from(word).forEach((ch) => {
      const charSpan = createEl(
        'span',
        isBrandName ? 'split-char gradient-char' : 'split-char',
        ch
      );
      wordSpan.appendChild(charSpan);
    });

    heroTitle.appendChild(wordSpan);
    if (wIdx < words.length - 1) {
      heroTitle.appendChild(document.createTextNode(' '));
    }
  });
}

function splitSectionHeading(heading) {
  if (!(heading instanceof HTMLElement) || prefersReducedMotion()) return [];
  if (heading.dataset.splitDone === 'true') {
    return Array.from(heading.querySelectorAll('.word-inner'));
  }

  const rawText = (heading.textContent || '').replace(/\s+/g, ' ').trim();
  if (!rawText) return [];

  heading.setAttribute('aria-label', rawText);
  heading.dataset.splitDone = 'true';
  heading.replaceChildren();

  const inners = [];
  const words = rawText.split(' ');
  words.forEach((word, idx) => {
    const mask = createEl('span', 'word-mask');
    mask.setAttribute('aria-hidden', 'true');
    const inner = createEl('span', 'word-inner', word);
    mask.appendChild(inner);
    heading.appendChild(mask);
    inners.push(inner);
    if (idx < words.length - 1) {
      heading.appendChild(document.createTextNode(' '));
    }
  });

  return inners;
}

function initPreloaderAndHeroIntro() {
  const preloader = document.getElementById('pagePreloader');
  const percentEl = document.getElementById('preloaderPercent');
  const barFill = document.getElementById('preloaderBarFill');
  const reduced = prefersReducedMotion();

  splitHeroTitle();

  if (reduced) {
    if (preloader) preloader.classList.add('is-done');
    return;
  }

  const master = gsap.timeline({ defaults: { ease: 'power3.out' } });

  if (preloader) {
    const counter = { value: 0 };
    master
      .to(counter, {
        value: 100,
        duration: 0.52,
        ease: 'power2.out',
        onUpdate: () => {
          const pct = Math.round(counter.value);
          if (percentEl) percentEl.textContent = `${pct}%`;
        },
      })
      .to(
        barFill,
        {
          scaleX: 1,
          duration: 0.52,
          ease: 'power2.out',
        },
        '<'
      )
      .to(
        '.preloader-inner',
        {
          y: -14,
          opacity: 0,
          duration: 0.28,
          ease: 'power2.in',
        },
        '+=0.06'
      )
      .to(
        preloader,
        {
          clipPath: 'inset(0 0 100% 0)',
          duration: 0.54,
          ease: 'expo.inOut',
          onComplete: () => {
            preloader.classList.add('is-done');
            preloader.setAttribute('hidden', '');
          },
        },
        '-=0.12'
      );
  }

  const nav = document.querySelector('.navbar');
  const heroChars = document.querySelectorAll('.hero-title .split-char');
  const portraitFrame = document.querySelector('.portrait-frame');
  const portraitImg = document.querySelector('.portrait-img');
  const orbitalRings = document.querySelectorAll('.orbital-ring');
  const float3d = document.querySelectorAll('.floating-3d-card, .code-fragment');

  const heroStart = preloader ? '-=0.28' : '0';

  if (nav) {
    master.from(
      nav,
      {
        y: -26,
        opacity: 0,
        duration: 0.65,
        ease: 'expo.out',
        clearProps: 'transform,opacity',
      },
      heroStart
    );
  }

  master.from(
    '.hero-utility-bar',
    {
      y: -12,
      opacity: 0,
      duration: 0.52,
      clearProps: 'transform,opacity',
    },
    '<0.08'
  );

  master.from(
    '.hero-kicker',
    {
      y: 16,
      opacity: 0,
      duration: 0.5,
      clearProps: 'transform,opacity',
    },
    '<0.06'
  );

  if (heroChars.length > 0) {
    master.from(
      heroChars,
      {
        yPercent: 90,
        rotateX: -62,
        opacity: 0,
        duration: 0.72,
        stagger: 0.022,
        ease: 'expo.out',
        clearProps: 'transform,opacity',
      },
      '<0.05'
    );
  }

  master.from(
    ['.hero-typed-line', '.hero-statement', '.hero-signature', '.hero-cta-row', '.hero-socials'],
    {
      y: 22,
      opacity: 0,
      duration: 0.62,
      stagger: 0.065,
      ease: 'power3.out',
      clearProps: 'transform,opacity',
    },
    '<0.14'
  );

  if (portraitFrame) {
    master.fromTo(
      portraitFrame,
      {
        clipPath: 'inset(14% 6% 14% 6% round 24px)',
        opacity: 0.25,
      },
      {
        clipPath: 'inset(0% 0% 0% 0% round 24px)',
        opacity: 1,
        duration: 0.92,
        ease: 'expo.out',
        clearProps: 'clipPath,opacity',
      },
      heroStart
    );
  }

  if (portraitImg) {
    master.from(
      portraitImg,
      {
        scale: 1.15,
        duration: 1.05,
        ease: 'power3.out',
        clearProps: 'transform',
      },
      '<'
    );
  }

  if (orbitalRings.length > 0) {
    master.from(
      orbitalRings,
      {
        scale: 0.82,
        opacity: 0,
        duration: 0.8,
        stagger: 0.1,
        ease: 'power2.out',
        clearProps: 'scale,opacity',
      },
      '<0.1'
    );
  }

  if (float3d.length > 0) {
    master.from(
      float3d,
      {
        scale: 0.85,
        y: 18,
        opacity: 0,
        duration: 0.65,
        stagger: 0.09,
        ease: 'back.out(1.4)',
        clearProps: 'scale,y,opacity',
      },
      '<0.18'
    );
  }

  master.from(
    '.hero-scroll-row',
    {
      y: 12,
      opacity: 0,
      duration: 0.5,
      clearProps: 'transform,opacity',
    },
    '-=0.25'
  );
}

function initThemeToggle() {
  const html = document.documentElement;
  const toggleBtn = document.getElementById('themeToggle');
  const toggleLabel = document.getElementById('themeToggleLabel');
  const veil = document.getElementById('pageTransitionVeil');

  const applyTheme = (theme, animate = false) => {
    if (animate && !prefersReducedMotion()) {
      html.classList.add('theme-animating');
      if (veil) {
        gsap.fromTo(
          veil,
          { opacity: 0 },
          { opacity: 0.45, duration: 0.14, yoyo: true, repeat: 1, ease: 'sine.inOut' }
        );
      }
      window.setTimeout(() => html.classList.remove('theme-animating'), 340);
    }
    html.setAttribute('data-theme', theme);
    localStorage.setItem('yeasin_theme', theme);
    if (toggleLabel) {
      toggleLabel.textContent = theme === 'dark' ? 'Light Mode' : 'Dark Mode';
    }
  };

  const saved = localStorage.getItem('yeasin_theme');
  applyTheme(saved === 'light' ? 'light' : 'dark', false);

  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      const current = html.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
      applyTheme(current === 'dark' ? 'light' : 'dark', true);
    });
  }
}

function initHeroMotion() {
  const reduced = prefersReducedMotion();
  const fine = isFinePointer();

  // 1. Dynamic typing effect for identity roles
  const typedEl = document.getElementById('heroTypedRole');
  const roles = [
    'CSE Student',
    'Aspiring Software Engineer',
    'Prompt Engineering Enthusiast',
    'Creative Thinker',
    'Technology Explorer',
  ];

  if (typedEl) {
    if (reduced) {
      typedEl.textContent = roles[0];
    } else {
      let roleIdx = 0;
      let charIdx = roles[0].length;
      let deleting = true;

      const tickTyping = () => {
        const currentRole = roles[roleIdx];
        if (deleting) {
          charIdx = Math.max(0, charIdx - 1);
          typedEl.textContent = currentRole.slice(0, charIdx);
          if (charIdx === 0) {
            deleting = false;
            roleIdx = (roleIdx + 1) % roles.length;
            window.setTimeout(tickTyping, 280);
          } else {
            window.setTimeout(tickTyping, 36);
          }
        } else {
          charIdx = Math.min(currentRole.length, charIdx + 1);
          typedEl.textContent = currentRole.slice(0, charIdx);
          if (charIdx === currentRole.length) {
            deleting = true;
            window.setTimeout(tickTyping, 1750);
          } else {
            window.setTimeout(tickTyping, 62);
          }
        }
      };

      window.setTimeout(tickTyping, 1700);
    }
  }

  const heroStage = document.getElementById('heroStage');
  const heroSection = document.getElementById('home');

  // 2. Morphing Aurora Shape in Hero (Desktop/Tablet only, paused when offscreen)
  const heroMorphPath = document.getElementById('heroMorphPath');
  const heroMorphTarget = document.getElementById('heroMorphPathTarget');
  if (heroMorphPath && heroMorphTarget && !reduced && window.innerWidth >= 768) {
    const morphTween = gsap.to(heroMorphPath, {
      morphSVG: heroMorphTarget,
      duration: 8.5,
      repeat: -1,
      yoyo: true,
      ease: 'sine.inOut',
    });

    if (heroSection) {
      ScrollTrigger.create({
        trigger: heroSection,
        start: 'top bottom',
        end: 'bottom top',
        onLeave: () => morphTween.pause(),
        onEnterBack: () => morphTween.resume(),
      });
    }
  }

  // 3. GSAP 60fps mouse-based 3D parallax on hero visual layers (desktop fine pointer)
  if (heroStage && heroSection && fine && !reduced) {
    const layers = Array.from(heroStage.querySelectorAll('.parallax-layer'));
    const layerControls = layers.map((layer) => ({
      depth: Number(layer.getAttribute('data-depth') || '0'),
      xTo: gsap.quickTo(layer, 'x', { duration: 0.55, ease: 'power3.out' }),
      yTo: gsap.quickTo(layer, 'y', { duration: 0.55, ease: 'power3.out' }),
    }));
    const stageRotX = gsap.quickTo(heroStage, 'rotateX', { duration: 0.65, ease: 'power3.out' });
    const stageRotY = gsap.quickTo(heroStage, 'rotateY', { duration: 0.65, ease: 'power3.out' });

    heroSection.addEventListener(
      'mousemove',
      (e) => {
        const rect = heroSection.getBoundingClientRect();
        const nx = (e.clientX - rect.left) / rect.width - 0.5;
        const ny = (e.clientY - rect.top) / rect.height - 0.5;
        layerControls.forEach((ctrl) => {
          ctrl.xTo(nx * ctrl.depth * 1.4);
          ctrl.yTo(ny * ctrl.depth * 1.4);
        });
        stageRotX(-ny * 5);
        stageRotY(nx * 6);
      },
      { passive: true }
    );

    heroSection.addEventListener('mouseleave', () => {
      layerControls.forEach((ctrl) => {
        ctrl.xTo(0);
        ctrl.yTo(0);
      });
      stageRotX(0);
      stageRotY(0);
    });
  }

  // 4. Scroll-driven Hero exit parallax
  if (heroSection && !reduced) {
    const mm = gsap.matchMedia();
    mm.add('(min-width: 768px)', () => {
      gsap.to('.hero-copy', {
        y: -46,
        opacity: 0.72,
        ease: 'none',
        scrollTrigger: {
          trigger: heroSection,
          start: 'top top',
          end: 'bottom top',
          scrub: 0.8,
        },
      });
      if (heroStage) {
        gsap.to(heroStage, {
          y: -26,
          scale: 0.96,
          ease: 'none',
          scrollTrigger: {
            trigger: heroSection,
            start: 'top top',
            end: 'bottom top',
            scrub: 0.8,
          },
        });
      }
      gsap.to('.hero-scroll-row', {
        opacity: 0,
        y: 10,
        ease: 'none',
        scrollTrigger: {
          trigger: heroSection,
          start: '10% top',
          end: '35% top',
          scrub: true,
        },
      });
    });
  }

  // 5. Lightweight canvas particle network inside hero (adaptive node density, visible viewport only)
  const canvas = document.getElementById('heroParticles');
  if (canvas instanceof HTMLCanvasElement && heroSection && fine && !reduced && window.innerWidth >= 768) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let active = true;
    let animId = null;
    const nodeCount = window.innerWidth >= 1024 ? 22 : 12;

    const nodes = Array.from({ length: nodeCount }, () => ({
      x: Math.random(),
      y: Math.random(),
      vx: (Math.random() - 0.5) * 0.0005,
      vy: (Math.random() - 0.5) * 0.0005,
      r: 1.3 + Math.random() * 1.4,
    }));

    const resize = () => {
      const rect = heroSection.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    resize();
    window.addEventListener('resize', resize, { passive: true });

    const draw = () => {
      if (!active) {
        animId = null;
        return;
      }
      ctx.clearRect(0, 0, width, height);
      const isLight = document.documentElement.getAttribute('data-theme') === 'light';
      const dotColor = isLight ? 'rgba(124, 58, 237, 0.25)' : 'rgba(34, 211, 238, 0.35)';
      const lineBase = isLight ? '124, 58, 237' : '139, 92, 246';

      for (let i = 0; i < nodes.length; i++) {
        const n = nodes[i];
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < 0 || n.x > 1) n.vx *= -1;
        if (n.y < 0 || n.y > 1) n.vy *= -1;

        const px = n.x * width;
        const py = n.y * height;

        ctx.beginPath();
        ctx.arc(px, py, n.r, 0, Math.PI * 2);
        ctx.fillStyle = dotColor;
        ctx.fill();

        for (let j = i + 1; j < nodes.length; j++) {
          const m = nodes[j];
          const dx = (n.x - m.x) * width;
          const dy = (n.y - m.y) * height;
          const dist = Math.hypot(dx, dy);
          if (dist < 155) {
            const alpha = (1 - dist / 155) * 0.16;
            ctx.beginPath();
            ctx.moveTo(px, py);
            ctx.lineTo(m.x * width, m.y * height);
            ctx.strokeStyle = `rgba(${lineBase}, ${alpha.toFixed(3)})`;
            ctx.lineWidth = 1;
            ctx.stroke();
          }
        }
      }

      animId = window.requestAnimationFrame(draw);
    };

    if ('IntersectionObserver' in window) {
      const heroObserver = new IntersectionObserver(
        (entries) => {
          active = Boolean(entries[0] && entries[0].isIntersecting);
          if (active && !animId) {
            animId = window.requestAnimationFrame(draw);
          }
        },
        { threshold: 0.05 }
      );
      heroObserver.observe(heroSection);
    }

    animId = window.requestAnimationFrame(draw);
  }
}

function initKineticRibbon() {
  const track = document.getElementById('kineticRibbonTrack');
  if (!track || prefersReducedMotion()) return;

  const ribbonTween = gsap.to(track, {
    xPercent: -50,
    duration: 28,
    ease: 'none',
    repeat: -1,
  });

  ScrollTrigger.create({
    trigger: track,
    start: 'top bottom',
    end: 'bottom top',
    onLeave: () => ribbonTween.pause(),
    onEnterBack: () => ribbonTween.resume(),
    onUpdate: (self) => {
      const vel = Math.min(3.5, Math.abs(self.getVelocity()) / 450);
      gsap.to(ribbonTween, {
        timeScale: 1 + vel,
        duration: 0.35,
        overwrite: 'auto',
      });
    },
  });
}

function initSkillsSection() {
  const grid = document.getElementById('toolkitGrid');
  const tabs = Array.from(document.querySelectorAll('[data-level-filter]'));
  if (!grid) return;

  const reduced = prefersReducedMotion();
  const fine = isFinePointer();

  const levelWeight = {
    Advanced: 0.92,
    Active: 0.8,
    Intermediate: 0.68,
    Beginner: 0.38,
  };

  const animateSkillVisuals = (container) => {
    if (reduced) return;

    const cards = Array.from(container.querySelectorAll('.skill-card'));
    const rings = Array.from(container.querySelectorAll('.skill-ring-progress'));
    const meters = Array.from(container.querySelectorAll('.skill-meter-fill'));
    const counts = Array.from(container.querySelectorAll('.skill-count'));

    gsap.from(cards, {
      y: 28,
      rotateX: 10,
      scale: 0.96,
      opacity: 0,
      transformPerspective: 900,
      duration: 0.65,
      stagger: 0.07,
      ease: 'expo.out',
      clearProps: 'transform,opacity',
    });

    rings.forEach((ring) => {
      const target = Number(ring.getAttribute('data-target-offset') || '26');
      gsap.fromTo(
        ring,
        { strokeDashoffset: 88 },
        { strokeDashoffset: target, duration: 1.05, ease: 'power3.out' }
      );
    });

    meters.forEach((meter, idx) => {
      const targetScale = Number(meter.getAttribute('data-scale') || '0.5');
      gsap.fromTo(
        meter,
        { scaleX: 0 },
        { scaleX: targetScale, duration: 0.85, delay: idx * 0.03, ease: 'expo.out' }
      );
    });

    counts.forEach((el) => {
      const target = Number(el.getAttribute('data-count') || '0');
      const obj = { n: 0 };
      gsap.to(obj, {
        n: target,
        duration: 0.75,
        ease: 'power2.out',
        onUpdate: () => {
          el.textContent = String(Math.round(obj.n)).padStart(2, '0');
        },
      });
    });
  };

  const renderSkills = (levelFilter, animateImmediate = false) => {
    grid.replaceChildren();

    PORTFOLIO_DATA.skills.forEach((category) => {
      const filteredItems =
        levelFilter === 'all'
          ? category.items
          : category.items.filter((item) => item.level === levelFilter);

      if (filteredItems.length === 0) return;

      const avgWeight =
        filteredItems.reduce((sum, item) => sum + (levelWeight[item.level] || 0.6), 0) /
        filteredItems.length;
      const ringOffset = Math.round(88 * (1 - avgWeight));

      const card = createEl('article', 'glass-panel skill-card');
      attachCardSheen(card);

      const topBar = createEl('div', `panel-top-line ${category.gradientClass}`);
      topBar.setAttribute('aria-hidden', 'true');
      card.appendChild(topBar);

      const headerWrap = createEl('div');
      const head = createEl('div', 'skill-card-head');

      const titleGroup = createEl('div', 'skill-card-title-group');
      const iconBox = createEl('span', `skill-icon-box ${category.gradientClass}`, category.iconText);
      iconBox.setAttribute('aria-hidden', 'true');
      const title = createEl('h3', '', category.title);
      titleGroup.append(iconBox, title);

      // SVG Circular Progress Ring around category item count
      const ringWrap = createEl('div', 'skill-ring-wrap');
      const svgNS = 'http://www.w3.org/2000/svg';
      const ringSvg = document.createElementNS(svgNS, 'svg');
      ringSvg.setAttribute('class', 'skill-ring-svg');
      ringSvg.setAttribute('viewBox', '0 0 36 36');
      ringSvg.setAttribute('aria-hidden', 'true');
      ringSvg.style.position = 'absolute';
      ringSvg.style.inset = '0';

      const trackCircle = document.createElementNS(svgNS, 'circle');
      trackCircle.setAttribute('class', 'skill-ring-track');
      trackCircle.setAttribute('cx', '18');
      trackCircle.setAttribute('cy', '18');
      trackCircle.setAttribute('r', '14');

      const progCircle = document.createElementNS(svgNS, 'circle');
      progCircle.setAttribute('class', 'skill-ring-progress');
      progCircle.setAttribute('cx', '18');
      progCircle.setAttribute('cy', '18');
      progCircle.setAttribute('r', '14');
      progCircle.style.setProperty('--ring-offset', String(ringOffset));
      progCircle.setAttribute('data-target-offset', String(ringOffset));

      ringSvg.append(trackCircle, progCircle);
      const count = createEl(
        'span',
        'skill-count',
        String(filteredItems.length).padStart(2, '0')
      );
      count.setAttribute('data-count', String(filteredItems.length));
      ringWrap.append(ringSvg, count);
      head.append(titleGroup, ringWrap);

      const note = createEl('p', 'skill-card-note', category.note);
      headerWrap.append(head, note);

      const itemsGrid = createEl('div', 'skill-items-grid');
      filteredItems.forEach((skill) => {
        const item = createEl('div', 'skill-item');
        const topRow = createEl('div', 'skill-item-top');
        const nameSpan = createEl('span', '', skill.name);
        const levelKey = skill.level.toLowerCase();
        const levelSpan = createEl('span', `skill-level level-${levelKey}`, skill.level);
        topRow.append(nameSpan, levelSpan);

        const meterTrack = createEl('div', 'skill-meter-track');
        meterTrack.setAttribute('aria-hidden', 'true');
        const meterFill = createEl('div', `skill-meter-fill meter-${levelKey}`);
        meterFill.setAttribute('data-scale', String(levelWeight[skill.level] || 0.5));
        meterTrack.appendChild(meterFill);

        item.append(topRow, meterTrack);
        itemsGrid.appendChild(item);
      });

      card.append(headerWrap, itemsGrid);

      if (fine && !reduced) {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const rx = ((e.clientY - rect.top) / rect.height - 0.5) * -4.2;
          const ry = ((e.clientX - rect.left) / rect.width - 0.5) * 4.2;
          card.style.transform = `perspective(880px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) translateY(-4px)`;
        });
        card.addEventListener('mouseleave', () => {
          card.style.transform = '';
        });
      }

      grid.appendChild(card);
    });

    if (animateImmediate) {
      animateSkillVisuals(grid);
      ScrollTrigger.refresh();
    }
  };

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const level = tab.getAttribute('data-level-filter') || 'all';
      tabs.forEach((t) => {
        const active = t === tab;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', String(active));
      });
      renderSkills(level, true);
    });
  });

  renderSkills('all', false);

  if (!reduced) {
    ScrollTrigger.create({
      trigger: '#skills',
      start: 'top 76%',
      once: true,
      onEnter: () => animateSkillVisuals(grid),
    });
  }
}

function initPromptShowcase() {
  const pillarsGrid = document.getElementById('promptPillarsGrid');
  const bodyEl = document.getElementById('promptBlueprintBody');
  const promptTabs = Array.from(document.querySelectorAll('[data-prompt-id]'));
  const reduced = prefersReducedMotion();

  if (pillarsGrid) {
    pillarsGrid.replaceChildren();
    PORTFOLIO_DATA.promptPillars.forEach((pillar) => {
      const card = createEl('article', 'glass-panel prompt-pillar-card');
      attachCardSheen(card);
      card.appendChild(createEl('h3', '', pillar.title));
      card.appendChild(createEl('p', '', pillar.desc));
      pillarsGrid.appendChild(card);
    });
  }

  const renderExperiment = (id, animate = false) => {
    if (!bodyEl) return;
    const exp = PORTFOLIO_DATA.promptExperiments[id] || PORTFOLIO_DATA.promptExperiments.debug;
    bodyEl.replaceChildren();

    const blocks = [
      { label: '01. Role Framing', text: exp.role },
      { label: '02. Context & Inputs', text: exp.context },
      { label: '03. Explicit Constraints', text: exp.constraints },
      { label: '04. Human Verification', text: exp.evaluation },
    ];

    blocks.forEach((blk) => {
      const box = createEl('div', 'blueprint-block');
      box.appendChild(createEl('p', 'blueprint-label', blk.label));
      box.appendChild(createEl('p', 'blueprint-text', blk.text));
      bodyEl.appendChild(box);
    });

    if (animate && !reduced) {
      gsap.from(bodyEl.children, {
        y: 12,
        opacity: 0,
        duration: 0.34,
        stagger: 0.045,
        ease: 'power2.out',
        clearProps: 'transform,opacity',
      });
    }
  };

  promptTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const id = tab.getAttribute('data-prompt-id') || 'debug';
      promptTabs.forEach((t) => {
        const active = t === tab;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', String(active));
      });
      renderExperiment(id, true);
    });
  });

  renderExperiment('debug', false);
}

function initCreativeThinking() {
  const grid = document.getElementById('creativityGrid');
  const reduced = prefersReducedMotion();

  if (grid) {
    grid.replaceChildren();
    PORTFOLIO_DATA.creativePillars.forEach((item) => {
      const card = createEl('article', 'glass-panel creative-card');
      attachCardSheen(card);
      card.appendChild(createEl('span', 'creative-index', item.index));
      card.appendChild(createEl('h3', '', item.title));
      card.appendChild(createEl('p', '', item.desc));
      grid.appendChild(card);
    });
  }

  // Interactive Tri-Node Network connecting Technical, AI, and Creative Thinking
  const network = document.getElementById('thinkingNetwork');
  const synthesisEl = document.getElementById('thinkingSynthesis');
  const morphPath = document.getElementById('creativeMorphPath');
  if (!network || !synthesisEl) return;

  const nodeButtons = Array.from(network.querySelectorAll('.thinking-node'));
  const summaries = {
    technical:
      'Technical Thinking provides algorithmic rigor, clean data structures, and reliable execution—turning abstract concepts into working systems.',
    ai:
      'AI Thinking translates engineering constraints and creative intent into structured prompts, decomposing complex work while critically auditing results.',
    creative:
      'Creative Thinking asks why an interface matters, shaping typography, layout rhythm, and human-centered curiosity before a single line is written.',
  };

  const morphShapes = {
    technical: 'M0,130 C160,40 280,190 450,115 C610,45 710,160 800,105 L800,220 L0,220 Z',
    ai: 'M0,95 C190,185 330,20 470,95 C610,170 700,40 800,110 L800,220 L0,220 Z',
    creative: 'M0,150 C140,85 260,30 420,120 C590,210 680,65 800,85 L800,220 L0,220 Z',
  };

  let activeKey = '';
  const selectNode = (key, animate = true) => {
    if (key === activeKey) return;
    activeKey = key;
    network.setAttribute('data-active-node', key);
    nodeButtons.forEach((btn) => {
      const active = btn.getAttribute('data-node') === key;
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-selected', String(active));
    });
    synthesisEl.textContent = summaries[key] || summaries.technical;

    if (animate && !reduced) {
      gsap.fromTo(
        synthesisEl,
        { opacity: 0.4, y: 4 },
        { opacity: 1, y: 0, duration: 0.28, ease: 'power2.out' }
      );
      if (morphPath && morphShapes[key]) {
        gsap.to(morphPath, {
          morphSVG: morphShapes[key],
          duration: 0.75,
          ease: 'power3.out',
        });
      }
    }
  };

  nodeButtons.forEach((btn) => {
    const key = btn.getAttribute('data-node') || 'technical';
    btn.addEventListener('click', () => selectNode(key, true));
    btn.addEventListener('mouseenter', () => selectNode(key, true));
  });

  selectNode('technical', false);
}

function initProjectGallery() {
  const grid = document.getElementById('projectsGrid');
  const tabs = Array.from(document.querySelectorAll('[data-project-filter]'));
  const modal = document.getElementById('projectModal');
  const modalCard = document.getElementById('projectModalCard');
  const modalCloseBtn = document.getElementById('modalCloseBtn');
  const modalImage = document.getElementById('modalImage');
  const modalMeta = document.getElementById('modalMeta');
  const modalTitle = document.getElementById('modalTitle');
  const modalDesc = document.getElementById('modalDesc');
  const modalStoryBlocks = document.getElementById('modalStoryBlocks');
  const modalLinks = document.getElementById('modalLinks');

  const reducedMotion = prefersReducedMotion();
  const finePointer = isFinePointer();

  if (!grid || !modal) return;

  const openModal = (project) => {
    if (modalImage instanceof HTMLImageElement) {
      modalImage.src = project.image;
      modalImage.alt = `${project.title} preview`;
    }
    if (modalMeta) {
      modalMeta.textContent = `${project.category} · ${project.status}`;
    }
    if (modalTitle) {
      modalTitle.textContent = project.title;
    }
    if (modalDesc) {
      modalDesc.textContent = project.summary;
    }
    if (modalStoryBlocks) {
      modalStoryBlocks.replaceChildren();
      const parts = [
        { label: 'Problem Addressed', text: project.problem },
        { label: 'Solution Approach', text: project.solution },
        { label: 'Key Features', text: project.features.join(' · ') },
        { label: 'Technologies Used', text: project.technologies.join(' · ') },
      ];
      parts.forEach((part) => {
        const box = createEl('div', 'modal-story-box');
        box.appendChild(createEl('h4', '', part.label));
        box.appendChild(createEl('p', '', part.text));
        modalStoryBlocks.appendChild(box);
      });
    }
    if (modalLinks) {
      modalLinks.replaceChildren();

      const ghLink = createEl('a', 'btn-secondary btn-sm', 'GitHub Repository');
      if (ghLink instanceof HTMLAnchorElement) {
        ghLink.href = project.githubUrl;
        ghLink.target = '_blank';
        ghLink.rel = 'noopener noreferrer';
      }

      const demoLink = createEl('a', 'btn-primary btn-sm', 'Live Demonstration');
      if (demoLink instanceof HTMLAnchorElement) {
        demoLink.href = project.liveUrl;
        if (project.liveUrl.startsWith('http')) {
          demoLink.target = '_blank';
          demoLink.rel = 'noopener noreferrer';
        } else {
          demoLink.addEventListener('click', () => {
            modal.hidden = true;
          });
        }
      }

      modalLinks.append(ghLink, demoLink);
    }

    modal.hidden = false;

    if (!reducedMotion && modalCard) {
      const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
      tl.fromTo(modal, { opacity: 0 }, { opacity: 1, duration: 0.25 })
        .fromTo(
          modalCard,
          { y: 26, scale: 0.94, opacity: 0 },
          { y: 0, scale: 1, opacity: 1, duration: 0.42, clearProps: 'transform,opacity' },
          '-=0.14'
        )
        .from(
          '#modalStoryBlocks .modal-story-box',
          {
            y: 14,
            opacity: 0,
            duration: 0.34,
            stagger: 0.05,
            clearProps: 'transform,opacity',
          },
          '-=0.22'
        );
    }
  };

  const closeModal = () => {
    if (modal.hidden) return;
    if (reducedMotion || !modalCard) {
      modal.hidden = true;
      return;
    }
    gsap
      .timeline({
        onComplete: () => {
          modal.hidden = true;
        },
      })
      .to(modalCard, { y: 18, scale: 0.96, opacity: 0, duration: 0.2, ease: 'power2.in' })
      .to(modal, { opacity: 0, duration: 0.18 }, '-=0.1');
  };

  if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.hidden) closeModal();
  });

  const projectImageTriggers = [];

  const bindProjectImageParallax = () => {
    projectImageTriggers.forEach((st) => st.kill());
    projectImageTriggers.length = 0;

    if (reducedMotion || window.innerWidth < 768) return;

    const imgs = Array.from(grid.querySelectorAll('.project-media-btn img'));
    imgs.forEach((img) => {
      const tween = gsap.fromTo(
        img,
        { yPercent: -5 },
        {
          yPercent: 5,
          ease: 'none',
          scrollTrigger: {
            trigger: img.closest('.project-card'),
            start: 'top bottom',
            end: 'bottom top',
            scrub: true,
          },
        }
      );
      if (tween.scrollTrigger) projectImageTriggers.push(tween.scrollTrigger);
    });
  };

  const renderProjects = (statusFilter, animateFilter = false) => {
    grid.replaceChildren();
    const filtered =
      statusFilter === 'all'
        ? PORTFOLIO_DATA.projects
        : PORTFOLIO_DATA.projects.filter((p) => p.status === statusFilter);

    filtered.forEach((project, idx) => {
      const spanClass = filtered.length <= 2 ? 'proj-span-half' : project.layoutSpan;
      const card = createEl('article', `glass-panel project-card ${spanClass}`);
      attachCardSheen(card);

      const topBar = createEl('div', `panel-top-line ${project.gradientClass}`);
      topBar.setAttribute('aria-hidden', 'true');
      card.appendChild(topBar);

      const topWrap = createEl('div');
      const mediaBtn = createEl('button', 'project-media-btn');
      if (mediaBtn instanceof HTMLButtonElement) {
        mediaBtn.type = 'button';
      }
      mediaBtn.setAttribute('aria-label', `Inspect details for ${project.title}`);
      mediaBtn.addEventListener('click', () => openModal(project));

      const img = document.createElement('img');
      img.src = project.image;
      img.alt = `${project.title} preview`;
      img.loading = idx === 0 ? 'eager' : 'lazy';
      img.referrerPolicy = 'no-referrer';
      img.addEventListener('error', () => {
        img.style.display = 'none';
      });
      const overlay = createEl('span', 'project-media-overlay', 'Inspect Case Study →');
      overlay.setAttribute('aria-hidden', 'true');
      mediaBtn.append(img, overlay);

      const body = createEl('div', 'project-body');
      const kicker = createEl('p', 'project-kicker');
      const catSpan = createEl('span', '', `${project.category} · `);
      const statusSpan = createEl(
        'span',
        `status-${project.status.toLowerCase()}`,
        project.status
      );
      kicker.append(catSpan, statusSpan);

      body.appendChild(kicker);
      body.appendChild(createEl('h3', 'project-title', project.title));
      body.appendChild(createEl('p', 'project-summary', project.summary));

      const miniStory = createEl('p', 'project-story-mini');
      miniStory.append(
        createEl('strong', '', 'Problem: '),
        document.createTextNode(project.problem)
      );
      body.appendChild(miniStory);

      body.appendChild(
        createEl('p', 'project-stack-line', project.technologies.join(' · '))
      );

      topWrap.append(mediaBtn, body);

      const footer = createEl('div', 'project-footer');
      const storyBtn = createEl('button', 'project-story-trigger', 'Inspect Details →');
      if (storyBtn instanceof HTMLButtonElement) {
        storyBtn.type = 'button';
      }
      storyBtn.addEventListener('click', () => openModal(project));

      const links = createEl('div', 'project-links');
      const gh = createEl('a', '', 'GitHub');
      if (gh instanceof HTMLAnchorElement) {
        gh.href = project.githubUrl;
        gh.target = '_blank';
        gh.rel = 'noopener noreferrer';
      }

      const live = createEl('a', '', 'Live Demo');
      if (live instanceof HTMLAnchorElement) {
        live.href = project.liveUrl;
        if (project.liveUrl.startsWith('http')) {
          live.target = '_blank';
          live.rel = 'noopener noreferrer';
        }
      }

      links.append(gh, live);
      footer.append(storyBtn, links);

      card.append(topWrap, footer);

      // Smooth 3D perspective tilt on desktop
      if (finePointer && !reducedMotion) {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const rx = ((e.clientY - rect.top) / rect.height - 0.5) * -4.8;
          const ry = ((e.clientX - rect.left) / rect.width - 0.5) * 4.8;
          card.style.transform = `perspective(920px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) translateY(-4px)`;
        });
        card.addEventListener('mouseleave', () => {
          card.style.transform = '';
        });
      }

      grid.appendChild(card);
    });

    bindProjectImageParallax();

    if (animateFilter && !reducedMotion) {
      const cards = Array.from(grid.querySelectorAll('.project-card'));
      const mediaBtns = Array.from(grid.querySelectorAll('.project-media-btn'));
      gsap.from(cards, {
        y: 28,
        scale: 0.96,
        opacity: 0,
        duration: 0.55,
        stagger: 0.07,
        ease: 'expo.out',
        clearProps: 'transform,opacity',
      });
      gsap.fromTo(
        mediaBtns,
        { clipPath: 'inset(16% 0 0 0)' },
        {
          clipPath: 'inset(0% 0 0 0)',
          duration: 0.65,
          stagger: 0.07,
          ease: 'expo.out',
          clearProps: 'clipPath',
        }
      );
      ScrollTrigger.refresh();
    }
  };

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const status = tab.getAttribute('data-project-filter') || 'all';
      tabs.forEach((t) => {
        const active = t === tab;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', String(active));
      });
      renderProjects(status, true);
    });
  });

  renderProjects('all', false);
}

function initLearningJourney() {
  const listEl = document.getElementById('journeyList');
  const detailEl = document.getElementById('journeyDetail');
  const lineFillEl = document.getElementById('journeyLineFill');
  const journeySection = document.getElementById('journey');
  if (!listEl || !detailEl) return;

  const reduced = prefersReducedMotion();
  let activeIdx = 0;
  let manualOverrideUntil = 0;

  const renderDetail = (item, animate = false) => {
    detailEl.replaceChildren();

    const bar = createEl('div', 'panel-top-line grad-aurora');
    bar.setAttribute('aria-hidden', 'true');
    detailEl.appendChild(bar);

    detailEl.appendChild(createEl('p', 'journey-detail-kicker', item.stage));
    detailEl.appendChild(createEl('h3', '', item.title));
    detailEl.appendChild(createEl('p', 'journey-detail-summary', item.summary));

    const ul = createEl('ul', 'journey-points');
    item.points.forEach((pt) => {
      ul.appendChild(createEl('li', '', pt));
    });
    detailEl.appendChild(ul);

    detailEl.appendChild(createEl('p', 'journey-focus-line', `Focus: ${item.focus}`));

    if (animate && !reduced) {
      gsap.fromTo(
        detailEl,
        { y: 10, opacity: 0.35 },
        { y: 0, opacity: 1, duration: 0.34, ease: 'power2.out', clearProps: 'transform,opacity' }
      );
    }
  };

  const syncStepButtons = (currentIdx) => {
    const buttons = Array.from(listEl.querySelectorAll('.journey-step-btn'));
    buttons.forEach((btn, idx) => {
      const isActive = idx === currentIdx;
      btn.classList.toggle('is-active', isActive);
      btn.classList.toggle('is-passed', idx < currentIdx);
      btn.setAttribute('aria-selected', String(isActive));
    });
  };

  const buildTimeline = () => {
    listEl.replaceChildren();
    PORTFOLIO_DATA.journey.forEach((item, idx) => {
      const btn = createEl(
        'button',
        `journey-step-btn${idx === activeIdx ? ' is-active' : ''}`
      );
      if (btn instanceof HTMLButtonElement) {
        btn.type = 'button';
      }
      btn.setAttribute('role', 'tab');
      btn.setAttribute('aria-selected', String(idx === activeIdx));
      btn.appendChild(createEl('p', 'journey-step-meta', item.stage));
      btn.appendChild(createEl('p', 'journey-step-title', item.title));

      btn.addEventListener('click', () => {
        manualOverrideUntil = Date.now() + 2500;
        activeIdx = idx;
        syncStepButtons(idx);
        renderDetail(item, true);
        if (lineFillEl && (reduced || window.innerWidth < 768)) {
          const ratio = (idx + 1) / PORTFOLIO_DATA.journey.length;
          lineFillEl.style.transform = `scaleY(${ratio.toFixed(3)})`;
        }
      });

      listEl.appendChild(btn);
    });
  };

  buildTimeline();
  renderDetail(PORTFOLIO_DATA.journey[0], false);

  if (lineFillEl && journeySection && !reduced) {
    const mm = gsap.matchMedia();
    mm.add('(min-width: 768px)', () => {
      gsap.fromTo(
        lineFillEl,
        { scaleY: 0.08 },
        {
          scaleY: 1,
          ease: 'none',
          scrollTrigger: {
            trigger: '#journeyTimeline',
            start: 'top 72%',
            end: 'bottom 68%',
            scrub: 0.4,
            onUpdate: (self) => {
              if (Date.now() < manualOverrideUntil) return;
              const total = PORTFOLIO_DATA.journey.length;
              const nextIdx = Math.min(total - 1, Math.max(0, Math.floor(self.progress * total)));
              if (nextIdx !== activeIdx) {
                activeIdx = nextIdx;
                syncStepButtons(activeIdx);
                renderDetail(PORTFOLIO_DATA.journey[activeIdx], true);
              }
            },
          },
        }
      );
    });
  }
}

function initToolsAndInterests() {
  const toolsGrid = document.getElementById('toolsGrid');
  if (toolsGrid) {
    toolsGrid.replaceChildren();
    PORTFOLIO_DATA.tools.forEach((tool) => {
      const card = createEl('article', 'glass-panel tool-card');
      attachCardSheen(card);
      card.appendChild(createEl('span', 'tool-category-label', tool.category));
      card.appendChild(createEl('h3', '', tool.name));
      card.appendChild(createEl('p', '', tool.desc));
      toolsGrid.appendChild(card);
    });
  }

  const beyondCards = document.getElementById('beyondCards');
  if (beyondCards) {
    beyondCards.replaceChildren();
    PORTFOLIO_DATA.interests.forEach((interest) => {
      const card = createEl('article', 'glass-panel beyond-card');
      attachCardSheen(card);
      card.appendChild(createEl('span', 'beyond-card-tag', interest.tag));
      card.appendChild(createEl('h3', '', interest.title));
      card.appendChild(createEl('p', '', interest.desc));
      beyondCards.appendChild(card);
    });
  }

  // Attach specular lighting to static panels too
  document
    .querySelectorAll('.about-manifesto, .story-tile, .prompt-lab-panel, .edu-card, .cred-card, .contact-universe')
    .forEach((panel) => attachCardSheen(panel));
}

function initPortraitGallery() {
  const grid = document.getElementById('portraitGalleryGrid');
  const lightbox = document.getElementById('portraitLightbox');
  const lightboxCard = document.getElementById('portraitLightboxCard');
  const closeBtn = document.getElementById('lightboxCloseBtn');
  const imgEl = document.getElementById('lightboxImage');
  const metaEl = document.getElementById('lightboxMeta');
  const titleEl = document.getElementById('lightboxTitle');
  const captionEl = document.getElementById('lightboxCaption');

  if (!grid) return;

  const reduced = prefersReducedMotion();
  const fine = isFinePointer();

  const openLightbox = (portrait) => {
    if (!lightbox) return;
    if (imgEl instanceof HTMLImageElement) {
      imgEl.src = portrait.src;
      imgEl.alt = portrait.alt;
    }
    if (metaEl) metaEl.textContent = portrait.frame;
    if (titleEl) titleEl.textContent = portrait.title;
    if (captionEl) captionEl.textContent = portrait.caption;

    lightbox.hidden = false;

    if (!reduced && lightboxCard) {
      gsap
        .timeline({ defaults: { ease: 'expo.out' } })
        .fromTo(lightbox, { opacity: 0 }, { opacity: 1, duration: 0.24 })
        .fromTo(
          lightboxCard,
          { y: 24, scale: 0.94, opacity: 0 },
          { y: 0, scale: 1, opacity: 1, duration: 0.4, clearProps: 'transform,opacity' },
          '-=0.14'
        );
    }
  };

  const closeLightbox = () => {
    if (!lightbox || lightbox.hidden) return;
    if (reduced || !lightboxCard) {
      lightbox.hidden = true;
      return;
    }
    gsap
      .timeline({
        onComplete: () => {
          lightbox.hidden = true;
        },
      })
      .to(lightboxCard, { y: 16, scale: 0.96, opacity: 0, duration: 0.18, ease: 'power2.in' })
      .to(lightbox, { opacity: 0, duration: 0.18 }, '-=0.1');
  };

  if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
  if (lightbox) {
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lightbox.hidden) closeLightbox();
    });
  }

  grid.replaceChildren();
  PORTFOLIO_DATA.portraits.forEach((portrait, idx) => {
    const card = createEl('article', 'glass-panel portrait-card');
    attachCardSheen(card);

    const topBar = createEl('div', `panel-top-line ${portrait.gradientClass}`);
    topBar.setAttribute('aria-hidden', 'true');
    card.appendChild(topBar);

    const btn = createEl('button', 'portrait-card-btn');
    if (btn instanceof HTMLButtonElement) {
      btn.type = 'button';
    }
    btn.setAttribute('aria-label', `View ${portrait.title}`);
    btn.addEventListener('click', () => openLightbox(portrait));

    const img = document.createElement('img');
    img.src = portrait.src;
    img.alt = portrait.alt;
    img.loading = idx < 3 ? 'eager' : 'lazy';
    img.referrerPolicy = 'no-referrer';

    const scrim = createEl('div', 'portrait-card-scrim');
    scrim.appendChild(createEl('span', 'portrait-card-meta', portrait.frame));
    scrim.appendChild(createEl('strong', 'portrait-card-title', portrait.title));

    btn.append(img, scrim);
    card.appendChild(btn);

    if (fine && !reduced) {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const rx = ((e.clientY - rect.top) / rect.height - 0.5) * -4.2;
        const ry = ((e.clientX - rect.left) / rect.width - 0.5) * 4.2;
        card.style.transform = `perspective(880px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) translateY(-4px)`;
      });
      card.addEventListener('mouseleave', () => {
        card.style.transform = '';
      });
    }

    grid.appendChild(card);
  });
}

function initSectionScrollChoreography() {
  if (prefersReducedMotion()) return;

  const mm = gsap.matchMedia();

  // Shared section heading word-mask reveals across all viewports
  document.querySelectorAll('.section-block .section-title').forEach((titleEl) => {
    const inners = splitSectionHeading(titleEl);
    const section = titleEl.closest('.section-block');
    if (!section || inners.length === 0) return;

    const kicker = section.querySelector('.section-kicker');
    const subtitle = section.querySelector('.section-subtitle');

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top 82%',
        once: true,
      },
    });

    if (kicker) {
      tl.from(kicker, {
        x: -14,
        opacity: 0,
        duration: 0.45,
        ease: 'power2.out',
        clearProps: 'transform,opacity',
      });
    }

    tl.from(
      inners,
      {
        yPercent: 108,
        opacity: 0,
        duration: 0.7,
        stagger: 0.045,
        ease: 'expo.out',
        clearProps: 'transform,opacity',
      },
      kicker ? '-=0.25' : '0'
    );

    if (subtitle) {
      tl.from(
        subtitle,
        {
          y: 14,
          opacity: 0,
          duration: 0.55,
          ease: 'power2.out',
          clearProps: 'transform,opacity',
        },
        '-=0.4'
      );
    }
  });

  // 1. ABOUT — Horizontal mask reveal + directional 3D story stagger + desktop parallax
  const aboutManifesto = document.querySelector('.about-manifesto');
  const aboutStories = Array.from(document.querySelectorAll('.about-stories .story-tile'));
  if (aboutManifesto) {
    gsap.fromTo(
      aboutManifesto,
      { clipPath: 'inset(0 100% 0 0 round 20px)', opacity: 0.4 },
      {
        clipPath: 'inset(0 0% 0 0 round 20px)',
        opacity: 1,
        duration: 0.9,
        ease: 'expo.out',
        clearProps: 'clipPath,opacity',
        scrollTrigger: {
          trigger: '#about',
          start: 'top 76%',
          once: true,
        },
      }
    );
  }
  if (aboutStories.length > 0) {
    aboutStories.forEach((tile, idx) => {
      const fromX = idx % 2 === 0 ? -22 : 22;
      const rotY = idx % 2 === 0 ? 6 : -6;
      gsap.from(tile, {
        x: fromX,
        y: 18,
        rotateY: rotY,
        opacity: 0,
        transformPerspective: 900,
        duration: 0.68,
        delay: idx * 0.08,
        ease: 'expo.out',
        clearProps: 'transform,opacity',
        scrollTrigger: {
          trigger: '.about-stories',
          start: 'top 80%',
          once: true,
        },
      });
    });

    mm.add('(min-width: 960px)', () => {
      gsap.to('.about-stories', {
        y: -26,
        ease: 'none',
        scrollTrigger: {
          trigger: '#about',
          start: 'top bottom',
          end: 'bottom top',
          scrub: 0.9,
        },
      });
    });
  }

  // 1B. EDITORIAL PORTRAITS — Shutter mask reveal & 3D perspective cascade
  const portraitCards = Array.from(document.querySelectorAll('#portraitGalleryGrid .portrait-card'));
  if (portraitCards.length > 0) {
    gsap.from(portraitCards, {
      y: 34,
      rotateX: 8,
      scale: 0.96,
      opacity: 0,
      transformPerspective: 920,
      duration: 0.72,
      stagger: 0.08,
      ease: 'expo.out',
      clearProps: 'transform,opacity',
      scrollTrigger: {
        trigger: '#portraitGalleryGrid',
        start: 'top 80%',
        once: true,
      },
    });
    gsap.fromTo(
      '#portraitGalleryGrid .portrait-card-btn',
      { clipPath: 'inset(16% 0 0 0)' },
      {
        clipPath: 'inset(0% 0 0 0)',
        duration: 0.8,
        stagger: 0.08,
        ease: 'expo.out',
        clearProps: 'clipPath',
        scrollTrigger: {
          trigger: '#portraitGalleryGrid',
          start: 'top 80%',
          once: true,
        },
      }
    );
  }

  // 2. PROMPT LAB — Diagonal capability cascade + architectural blueprint unfold
  const promptCards = Array.from(document.querySelectorAll('.prompt-pillar-card'));
  const promptPanel = document.querySelector('.prompt-lab-panel');
  if (promptCards.length > 0) {
    gsap.from(promptCards, {
      x: -14,
      y: 24,
      opacity: 0,
      duration: 0.58,
      stagger: 0.055,
      ease: 'expo.out',
      clearProps: 'transform,opacity',
      scrollTrigger: {
        trigger: '#prompt-lab',
        start: 'top 76%',
        once: true,
      },
    });
  }
  if (promptPanel) {
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: promptPanel,
        start: 'top 78%',
        once: true,
      },
    });
    tl.fromTo(
      promptPanel,
      { clipPath: 'inset(0 0 100% 0 round 20px)', opacity: 0.35 },
      {
        clipPath: 'inset(0 0 0% 0 round 20px)',
        opacity: 1,
        duration: 0.85,
        ease: 'expo.out',
        clearProps: 'clipPath,opacity',
      }
    ).from(
      '#promptBlueprintBody .blueprint-block',
      {
        y: 14,
        opacity: 0,
        duration: 0.42,
        stagger: 0.06,
        ease: 'power2.out',
        clearProps: 'transform,opacity',
      },
      '-=0.4'
    );
  }

  // 3. CREATIVE MINDSET — Wave stagger + interactive network reveal
  const creativeCards = Array.from(document.querySelectorAll('.creative-card'));
  if (creativeCards.length > 0) {
    gsap.from(creativeCards, {
      y: 26,
      scale: 0.94,
      opacity: 0,
      duration: 0.62,
      stagger: { each: 0.055, from: 'center' },
      ease: 'expo.out',
      clearProps: 'transform,opacity',
      scrollTrigger: {
        trigger: '#creativity',
        start: 'top 76%',
        once: true,
      },
    });
  }
  const thinkingNodes = Array.from(document.querySelectorAll('.thinking-node'));
  if (thinkingNodes.length > 0) {
    gsap.from(thinkingNodes, {
      y: 22,
      scale: 0.95,
      opacity: 0,
      duration: 0.6,
      stagger: 0.09,
      ease: 'back.out(1.2)',
      clearProps: 'transform,opacity',
      scrollTrigger: {
        trigger: '#thinkingNetwork',
        start: 'top 80%',
        once: true,
      },
    });
  }

  // 4. PROJECTS — 3D Perspective Cards + Media Mask Reveals
  const projectCards = Array.from(document.querySelectorAll('.project-card'));
  if (projectCards.length > 0) {
    gsap.from(projectCards, {
      y: 42,
      rotateX: 8,
      opacity: 0,
      transformPerspective: 1000,
      duration: 0.78,
      stagger: 0.1,
      ease: 'expo.out',
      clearProps: 'transform,opacity',
      scrollTrigger: {
        trigger: '#projectsGrid',
        start: 'top 78%',
        once: true,
      },
    });

    gsap.fromTo(
      '.project-media-btn',
      { clipPath: 'inset(18% 0 0 0)' },
      {
        clipPath: 'inset(0% 0 0 0)',
        duration: 0.85,
        stagger: 0.1,
        ease: 'expo.out',
        clearProps: 'clipPath',
        scrollTrigger: {
          trigger: '#projectsGrid',
          start: 'top 78%',
          once: true,
        },
      }
    );
  }

  // 5. EDUCATION — Coursework progressive nodes & credential cards
  const eduCard = document.querySelector('.edu-card');
  const courseItems = Array.from(document.querySelectorAll('.course-item'));
  const credCards = Array.from(document.querySelectorAll('.cred-card'));
  if (eduCard) {
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '#education',
        start: 'top 76%',
        once: true,
      },
    });
    tl.from(eduCard, {
      y: 24,
      opacity: 0,
      duration: 0.65,
      ease: 'expo.out',
      clearProps: 'transform,opacity',
    }).from(
      courseItems,
      {
        x: -16,
        opacity: 0,
        duration: 0.45,
        stagger: 0.06,
        ease: 'power3.out',
        clearProps: 'transform,opacity',
      },
      '-=0.3'
    );
  }
  if (credCards.length > 0) {
    gsap.from(credCards, {
      x: 24,
      opacity: 0,
      duration: 0.62,
      stagger: 0.12,
      ease: 'expo.out',
      clearProps: 'transform,opacity',
      scrollTrigger: {
        trigger: '.credentials-stack',
        start: 'top 80%',
        once: true,
      },
    });
  }

  // 6. LEARNING JOURNEY — Milestone entrance
  const journeySteps = Array.from(document.querySelectorAll('.journey-step-btn'));
  if (journeySteps.length > 0) {
    gsap.from(journeySteps, {
      x: -20,
      opacity: 0,
      duration: 0.55,
      stagger: 0.065,
      ease: 'expo.out',
      clearProps: 'transform,opacity',
      scrollTrigger: {
        trigger: '#journeyTimeline',
        start: 'top 78%',
        once: true,
      },
    });
  }

  // 7. TOOLS — 3D Matrix Settle
  const toolCards = Array.from(document.querySelectorAll('.tool-card'));
  if (toolCards.length > 0) {
    gsap.from(toolCards, {
      scale: 0.92,
      rotateY: -8,
      opacity: 0,
      transformPerspective: 900,
      duration: 0.62,
      stagger: 0.06,
      ease: 'expo.out',
      clearProps: 'transform,opacity',
      scrollTrigger: {
        trigger: '#toolsGrid',
        start: 'top 80%',
        once: true,
      },
    });
  }

  // 8. BEYOND THE SCREEN — Horizontal shutter image mask + parallax + staggered cards
  const beyondMedia = document.querySelector('.beyond-media');
  const beyondImg = document.querySelector('.beyond-media img');
  const beyondCards = Array.from(document.querySelectorAll('.beyond-card'));
  if (beyondMedia) {
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '#interests',
        start: 'top 76%',
        once: true,
      },
    });
    tl.fromTo(
      beyondMedia,
      { clipPath: 'inset(0 100% 0 0 round 20px)', opacity: 0.35 },
      {
        clipPath: 'inset(0 0% 0 0 round 20px)',
        opacity: 1,
        duration: 0.92,
        ease: 'expo.out',
        clearProps: 'clipPath,opacity',
      }
    );
    if (beyondImg) {
      tl.from(
        beyondImg,
        {
          scale: 1.14,
          duration: 1.0,
          ease: 'power3.out',
          clearProps: 'transform',
        },
        '<'
      );
    }
    mm.add('(min-width: 900px)', () => {
      if (beyondImg) {
        gsap.fromTo(
          beyondImg,
          { yPercent: -5 },
          {
            yPercent: 5,
            ease: 'none',
            scrollTrigger: {
              trigger: beyondMedia,
              start: 'top bottom',
              end: 'bottom top',
              scrub: true,
            },
          }
        );
      }
    });
  }
  if (beyondCards.length > 0) {
    gsap.from(beyondCards, {
      x: 20,
      y: 12,
      opacity: 0,
      duration: 0.58,
      stagger: 0.08,
      ease: 'expo.out',
      clearProps: 'transform,opacity',
      scrollTrigger: {
        trigger: '#beyondCards',
        start: 'top 80%',
        once: true,
      },
    });
  }

  // 9. CONTACT — Luminous Frame & Form Stagger
  const contactUniverse = document.querySelector('.contact-universe');
  if (contactUniverse) {
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '#contact',
        start: 'top 76%',
        once: true,
      },
    });
    tl.from(contactUniverse, {
      y: 30,
      scale: 0.97,
      opacity: 0,
      duration: 0.72,
      ease: 'expo.out',
      clearProps: 'transform,opacity',
    })
      .from(
        '.contact-channels .channel-row',
        {
          x: -18,
          opacity: 0,
          duration: 0.45,
          stagger: 0.07,
          ease: 'power2.out',
          clearProps: 'transform,opacity',
        },
        '-=0.36'
      )
      .from(
        '.contact-form .field-group, #contactSubmitBtn',
        {
          y: 16,
          opacity: 0,
          duration: 0.45,
          stagger: 0.055,
          ease: 'power2.out',
          clearProps: 'transform,opacity',
        },
        '-=0.35'
      );
  }

  // 10. FOOTER — Horizon glow sweep & elegant closing rise
  const footer = document.querySelector('.site-footer');
  if (footer) {
    gsap.from('.footer-inner > *, .footer-bottom > *', {
      y: 18,
      opacity: 0,
      duration: 0.58,
      stagger: 0.07,
      ease: 'power3.out',
      clearProps: 'transform,opacity',
      scrollTrigger: {
        trigger: footer,
        start: 'top 90%',
        once: true,
      },
    });
    gsap.fromTo(
      '.footer-horizon-glow',
      { xPercent: -20, opacity: 0.35 },
      {
        xPercent: 18,
        opacity: 0.9,
        ease: 'none',
        scrollTrigger: {
          trigger: footer,
          start: 'top bottom',
          end: 'bottom bottom',
          scrub: true,
        },
      }
    );
  }
}

function initScrollEffectsAndNavigation() {
  const progressBar = document.getElementById('scrollProgress');
  const navbar = document.querySelector('.navbar');
  const floatingTopBtn = document.getElementById('floatingTopBtn');
  const indicator = document.getElementById('navActiveIndicator');
  const veil = document.getElementById('pageTransitionVeil');
  const navLinks = Array.from(document.querySelectorAll('.nav-link'));
  const sections = navLinks
    .map((link) => {
      const id = link.getAttribute('data-section');
      return id ? document.getElementById(id) : null;
    })
    .filter(Boolean);

  const reduced = prefersReducedMotion();

  const moveNavIndicator = (activeLink) => {
    if (!indicator) return;
    if (!(activeLink instanceof HTMLElement)) {
      indicator.style.opacity = '0';
      return;
    }
    indicator.style.opacity = '1';
    indicator.style.width = `${activeLink.offsetWidth}px`;
    indicator.style.transform = `translateX(${activeLink.offsetLeft}px)`;
  };

  let scrollTicking = false;
  const updateScrollState = () => {
    scrollTicking = false;
    const scrollTop = window.scrollY;
    const maxScroll = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const ratio = maxScroll > 0 ? Math.min(1, Math.max(0, scrollTop / maxScroll)) : 0;

    if (progressBar) {
      progressBar.style.transform = `scaleX(${ratio})`;
    }
    if (!reduced) {
      document.documentElement.style.setProperty('--scroll-parallax', String(Math.min(scrollTop, 700)));
    }
    if (navbar) {
      navbar.classList.toggle('is-scrolled', scrollTop > 24);
    }
    if (floatingTopBtn) {
      floatingTopBtn.classList.toggle('is-visible', scrollTop > 420);
    }
    if (scrollTop < 180) {
      navLinks.forEach((link) => link.classList.remove('is-active'));
      moveNavIndicator(null);
    }
  };

  updateScrollState();
  window.addEventListener(
    'scroll',
    () => {
      if (!scrollTicking) {
        scrollTicking = true;
        window.requestAnimationFrame(updateScrollState);
      }
    },
    { passive: true }
  );

  window.addEventListener(
    'resize',
    () => {
      const currentActive = navLinks.find((l) => l.classList.contains('is-active'));
      moveNavIndicator(currentActive || null);
    },
    { passive: true }
  );

  if ('IntersectionObserver' in window) {
    const navObserver = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
        if (visible.length > 0) {
          const activeId = visible[0].target.id;
          let matchedLink = null;
          navLinks.forEach((link) => {
            const match = link.getAttribute('data-section') === activeId;
            link.classList.toggle('is-active', match);
            if (match) matchedLink = link;
          });
          moveNavIndicator(matchedLink);
        }
      },
      { rootMargin: '-25% 0px -55% 0px', threshold: [0.1, 0.3, 0.5] }
    );
    sections.forEach((sec) => {
      if (sec) navObserver.observe(sec);
    });
  }

  // Smooth GSAP anchor transitions for in-page navigation links
  document.addEventListener('click', (e) => {
    const anchor = e.target instanceof Element ? e.target.closest('a[href^="#"]') : null;
    if (!(anchor instanceof HTMLAnchorElement)) return;
    const hash = anchor.getAttribute('href') || '';
    if (hash.length <= 1) return;
    const target = document.querySelector(hash);
    if (!target) return;

    e.preventDefault();
    if (reduced) {
      target.scrollIntoView({ behavior: 'auto' });
      history.replaceState(null, '', hash);
      return;
    }

    if (veil) {
      gsap.fromTo(
        veil,
        { opacity: 0 },
        { opacity: 0.38, duration: 0.14, yoyo: true, repeat: 1, ease: 'sine.inOut' }
      );
    }

    gsap.to(window, {
      duration: 0.72,
      scrollTo: { y: target, offsetY: 78, autoKill: true },
      ease: 'power3.inOut',
      onComplete: () => {
        history.replaceState(null, '', hash);
      },
    });
  });
}

function initMobileMenu() {
  const btn = document.getElementById('mobileMenuBtn');
  const drawer = document.getElementById('mobileDrawer');
  if (!btn || !drawer) return;

  const openDrawer = () => {
    drawer.hidden = false;
    window.requestAnimationFrame(() => {
      drawer.classList.add('is-open');
    });
    btn.setAttribute('aria-expanded', 'true');
  };

  const closeDrawer = () => {
    drawer.classList.remove('is-open');
    btn.setAttribute('aria-expanded', 'false');
    window.setTimeout(() => {
      if (!drawer.classList.contains('is-open')) {
        drawer.hidden = true;
      }
    }, 240);
  };

  btn.addEventListener('click', () => {
    const isOpen = drawer.classList.contains('is-open') && !drawer.hidden;
    if (isOpen) {
      closeDrawer();
    } else {
      openDrawer();
    }
  });

  drawer.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeDrawer);
  });
}

function initDesktopEffects() {
  const reduced = prefersReducedMotion();
  const fine = isFinePointer();

  const cursorGlow = document.getElementById('cursorGlow');
  const cursorRing = document.getElementById('cursorRing');
  const cursorLabel = document.getElementById('cursorLabel');

  if (fine && !reduced) {
    const ringXTo = cursorRing ? gsap.quickTo(cursorRing, 'x', { duration: 0.18, ease: 'power3.out' }) : null;
    const ringYTo = cursorRing ? gsap.quickTo(cursorRing, 'y', { duration: 0.18, ease: 'power3.out' }) : null;

    window.addEventListener(
      'mousemove',
      (e) => {
        const mouseX = e.clientX;
        const mouseY = e.clientY;
        if (cursorGlow) {
          cursorGlow.style.opacity = '1';
          cursorGlow.style.background = `radial-gradient(460px circle at ${mouseX}px ${mouseY}px, rgba(139, 92, 246, 0.12), rgba(34, 211, 238, 0.05) 45%, transparent 70%)`;
        }
        if (cursorRing && ringXTo && ringYTo) {
          cursorRing.style.opacity = '1';
          ringXTo(mouseX);
          ringYTo(mouseY);

          const targetEl = e.target instanceof Element ? e.target : null;
          const labelHost = targetEl
            ? targetEl.closest('[data-cursor-label], .project-card, .portrait-card, .thinking-node')
            : null;
          let labelText = '';
          if (labelHost) {
            labelText =
              labelHost.getAttribute('data-cursor-label') ||
              (labelHost.classList.contains('project-card') || labelHost.classList.contains('portrait-card')
                ? 'View'
                : labelHost.classList.contains('thinking-node')
                  ? 'Explore'
                  : '');
          }
          const interactive = Boolean(
            targetEl && targetEl.closest('a, button, .project-card, .portrait-card, .thinking-node')
          );
          cursorRing.classList.toggle('is-hovering', interactive && !labelText);
          cursorRing.classList.toggle('has-label', Boolean(labelText));
          if (cursorLabel) cursorLabel.textContent = labelText;
        }
      },
      { passive: true }
    );

    document.addEventListener('mouseleave', () => {
      if (cursorGlow) cursorGlow.style.opacity = '0';
      if (cursorRing) {
        cursorRing.style.opacity = '0';
        cursorRing.classList.remove('has-label', 'is-hovering');
      }
    });

    document.querySelectorAll('.magnetic-btn').forEach((btn) => {
      const btnX = gsap.quickTo(btn, 'x', { duration: 0.28, ease: 'power3.out' });
      const btnY = gsap.quickTo(btn, 'y', { duration: 0.28, ease: 'power3.out' });
      btn.addEventListener('mousemove', (e) => {
        if (!(e instanceof MouseEvent)) return;
        const rect = btn.getBoundingClientRect();
        const dx = (e.clientX - (rect.left + rect.width / 2)) * 0.16;
        const dy = (e.clientY - (rect.top + rect.height / 2)) * 0.16;
        btnX(dx);
        btnY(dy);
      });
      btn.addEventListener('mouseleave', () => {
        btnX(0);
        btnY(0);
      });
    });
  }

  // Click ripple micro-interaction on primary/secondary buttons
  if (!reduced) {
    document.addEventListener('click', (e) => {
      const target = e.target instanceof Element ? e.target.closest('.btn-primary, .btn-secondary') : null;
      if (!target) return;
      const rect = target.getBoundingClientRect();
      const size = Math.max(rect.width, rect.height);
      const ripple = document.createElement('span');
      ripple.className = 'btn-ripple';
      ripple.style.width = `${size}px`;
      ripple.style.height = `${size}px`;
      ripple.style.left = `${e.clientX - rect.left - size / 2}px`;
      ripple.style.top = `${e.clientY - rect.top - size / 2}px`;
      target.appendChild(ripple);
      window.setTimeout(() => ripple.remove(), 540);
    });
  }
}

function initContactAndFooter() {
  const copyBtn = document.getElementById('copyEmailBtn');
  const emailValue = document.getElementById('emailValue');
  const form = document.getElementById('contactForm');
  const feedbackEl = document.getElementById('formFeedback');
  const submitBtn = document.getElementById('contactSubmitBtn');
  const backToTopBtn = document.getElementById('backToTopBtn');
  const floatingTopBtn = document.getElementById('floatingTopBtn');
  const yearEl = document.getElementById('currentYear');

  if (yearEl) {
    yearEl.textContent = String(new Date().getFullYear());
  }

  const scrollToTop = () => {
    if (prefersReducedMotion()) {
      window.scrollTo({ top: 0, behavior: 'auto' });
      return;
    }
    gsap.to(window, {
      duration: 0.78,
      scrollTo: { y: 0, autoKill: true },
      ease: 'power3.inOut',
    });
  };

  if (backToTopBtn) backToTopBtn.addEventListener('click', scrollToTop);
  if (floatingTopBtn) floatingTopBtn.addEventListener('click', scrollToTop);

  if (copyBtn && emailValue) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText((emailValue.textContent || PORTFOLIO_DATA.email).trim());
        copyBtn.textContent = 'Copied';
        if (!prefersReducedMotion()) {
          gsap.fromTo(copyBtn, { scale: 0.92 }, { scale: 1, duration: 0.25, ease: 'back.out(2)' });
        }
        window.setTimeout(() => {
          copyBtn.textContent = 'Copy';
        }, 2000);
      } catch {
        copyBtn.textContent = 'Copy';
      }
    });
  }

  const showFeedback = (type, message) => {
    if (!feedbackEl) return;
    feedbackEl.hidden = false;
    feedbackEl.className = `form-feedback ${type === 'error' ? 'is-error' : 'is-success'}`;
    feedbackEl.textContent = message;
    if (!prefersReducedMotion()) {
      gsap.fromTo(
        feedbackEl,
        { y: 8, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.3, ease: 'power2.out', clearProps: 'transform,opacity' }
      );
    }
  };

  if (form instanceof HTMLFormElement) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const payload = {
        name: String(formData.get('name') || '').trim(),
        email: String(formData.get('email') || '').trim(),
        subject: String(formData.get('subject') || '').trim(),
        message: String(formData.get('message') || '').trim(),
      };

      if (payload.name.length < 2) {
        showFeedback('error', 'Please enter your name (at least 2 characters).');
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(payload.email)) {
        showFeedback('error', 'Please provide a valid email address.');
        return;
      }
      if (payload.subject.length < 2) {
        showFeedback('error', 'Please enter a subject.');
        return;
      }
      if (payload.message.length < 10) {
        showFeedback('error', 'Please enter a message of at least 10 characters.');
        return;
      }

      const submitTextEl = submitBtn ? submitBtn.querySelector('.btn-submit-text') : null;
      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.disabled = true;
        submitBtn.classList.add('is-loading');
      }
      if (submitTextEl) submitTextEl.textContent = 'Sending...';

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          showFeedback('error', data.error || 'Unable to send message right now.');
        } else {
          const refNote = data.id ? ` (Ref: ${data.id})` : '';
          showFeedback('success', `${data.message}${refNote}`);
          form.reset();
        }
      } catch {
        showFeedback('error', 'Network error contacting the server. Please try again.');
      } finally {
        if (submitBtn instanceof HTMLButtonElement) {
          submitBtn.disabled = false;
          submitBtn.classList.remove('is-loading');
        }
        if (submitTextEl) submitTextEl.textContent = 'Send Message';
      }
    });
  }
}

document.addEventListener('DOMContentLoaded', () => {
  initThemeToggle();
  initPreloaderAndHeroIntro();
  initHeroMotion();
  initKineticRibbon();
  initSkillsSection();
  initPromptShowcase();
  initCreativeThinking();
  initProjectGallery();
  initLearningJourney();
  initToolsAndInterests();
  initPortraitGallery();
  initSectionScrollChoreography();
  initScrollEffectsAndNavigation();
  initMobileMenu();
  initDesktopEffects();
  initContactAndFooter();
  ScrollTrigger.refresh();
});

